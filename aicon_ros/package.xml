<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aicon_ros</name>
  <version>0.0.0</version>
  <description>Middleware for AICON based on ROS(2) Communication between the components. An asynchronous and multi-machine alternative to the default synchronous default middleware.</description>
  <maintainer email="v.mengers@tu-berlin.de">Vito Mengers</maintainer>
  <license>MIT</license>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Message generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <build_depend>rosidl_typesupport_cpp</build_depend>
  <build_depend>rosidl_typesupport_python</build_depend>

  <exec_depend>rosidl_typesupport_cpp</exec_depend>
  <exec_depend>rosidl_typesupport_python</exec_depend>

  <!-- Common dependencies -->
  <exec_depend>python3</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Export build type -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
